# AI Gateway — Environment Variables
# Copy this file to .env and fill in your API keys.
# Only providers with valid keys will be registered.

OPENAI_API_KEY=
GOOGLE_API_KEY=
ANTHROPIC_API_KEY=

# Gateway auth — when set, /api/* requires header X-API-Key matching this value.
# Generate with: openssl rand -hex 32
# Leave blank in Development; set it in production (Cloud Run free tier depends on this).
GATEWAY_API_KEY=

# GCP Project for Firestore persistence
GCP_PROJECT_ID=

# Session persistence TTL in minutes (sliding)
SESSION_TTL_MINUTES=30

# Embedding cache TTL in days
EMBEDDING_CACHE_TTL_DAYS=7

# Local development: path to your service account JSON
# GOOGLE_APPLICATION_CREDENTIALS=path/to/key.json

# Optional: override default model names per provider
# AI__OpenAi__FastModel=gpt-4o-mini
# AI__OpenAi__CapableModel=gpt-4o
# AI__Google__FastModel=gemini-2.0-flash
# AI__Google__CapableModel=gemini-2.0-pro
# AI__Anthropic__FastModel=claude-3-haiku-20240307
# AI__Anthropic__CapableModel=claude-3-5-sonnet-20241022
